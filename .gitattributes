# Forcer les fins de ligne LF pour tous les fichiers texte
* text=auto eol=lf

# Fichiers PHP
*.php text eol=lf

# HTML, CSS, JS
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf

# Fichiers de configuration et formats texte
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.xml  text eol=lf
*.sh   text eol=lf
*.sql  text eol=lf

# Garder les fichiers binaires intacts (pas de conversion de fin de ligne)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary